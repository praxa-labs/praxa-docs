{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Praxa",
  "theme": "mint",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://praxa.io"
  },
  "favicon": "/app-icon.png",
  "colors": {
    "primary": "#909090",
    "light": "#dddddd",
    "dark": "#1d1d1d"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/praxa-labs/praxa"
    }
  },
  "api": {
    "openapi": [
      "fabric/api/openapi.yaml",
      "memory-federation/openapi.yaml"
    ],
    "mdx": {
      "server": "https://api.praxa.io",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
