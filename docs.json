{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Praxa",
  "description": "Build governed AI agents with Praxa APIs, SDKs, CLI tools, MCP contracts, durable missions, webhooks, memory federation, tutorials, and benchmarks.",
  "theme": "mint",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://praxa.io"
  },
  "favicon": "/app-icon.png",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Praxa Developer Documentation",
      "twitter:card": "summary_large_image"
    }
  },
  "search": {
    "prompt": "Search Praxa APIs, SDK, CLI, MCP, memory, tutorials, and benchmarks"
  },
  "metadata": {
    "timestamp": true
  },
  "colors": {
    "primary": "#909090",
    "light": "#dddddd",
    "dark": "#1d1d1d"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/praxa-labs/praxa"
    }
  },
  "api": {
    "openapi": [
      "fabric/api/openapi.yaml",
      "memory-federation/openapi.yaml"
    ],
    "mdx": {
      "server": "https://api.praxa.io",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
